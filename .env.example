DATABASE_URL="postgresql://usuario:senha@localhost:5432/doutor_agenda"
# Opção B — Banco local embutido (PGlite) via `npm run db:start`
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5434/postgres"

